'use client';

import { FollowUpLog } from '@/lib/supabase/client';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { Avatar, AvatarFallback } from '@/components/ui/avatar';
import { 
  Phone, 
  Mail, 
  MessageSquare, 
  Home, 
  Calendar, 
  User, 
  Clock,
  Edit3,
  CheckCircle2,
  XCircle,
  Info,
  FileText,
  ArrowRight
} from 'lucide-react';
import { formatDistanceToNow, format } from 'date-fns';
import { id as idLocale } from 'date-fns/locale';
import { cn } from '@/lib/utils';

// ============================================
// CONSTANTS
// ============================================

const contactMethodIcons = {
  call: Phone,
  whatsapp: MessageSquare,
  email: Mail,
  visit: Home,
};

const contactMethodLabels = {
  call: 'Phone Call',
  whatsapp: 'WhatsApp',
  email: 'Email',
  visit: 'Site Visit',
};

const contactMethodColors = {
  call: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  whatsapp: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  email: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
  visit: 'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200',
};

const outcomeIcons = {
  interested: CheckCircle2,
  not_interested: XCircle,
  need_info: Info,
  agreed_survey: Calendar,
  survey_done: CheckCircle2,
  agreed_booking: CheckCircle2,
};

const outcomeLabels = {
  interested: 'Interested',
  not_interested: 'Not Interested',
  need_info: 'Needs More Info',
  agreed_survey: 'Agreed to Survey',
  survey_done: 'Survey Completed',
  agreed_booking: 'Agreed to Book',
};

const outcomeColors = {
  interested: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  not_interested: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
  need_info: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
  agreed_survey: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  survey_done: 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200',
  agreed_booking: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
};

const nextActionIcons = {
  call: Phone,
  send_info: FileText,
  schedule_survey: Calendar,
  send_proposal: FileText,
  close: CheckCircle2,
};

const nextActionLabels = {
  call: 'Follow-up Call',
  send_info: 'Send Information',
  schedule_survey: 'Schedule Survey',
  send_proposal: 'Send Proposal',
  close: 'Close Deal',
};

// ============================================
// COMPONENT
// ============================================

interface FollowUpHistoryProps {
  followUps: FollowUpLog[];
  currentUserId?: string;
  className?: string;
}

export function FollowUpHistory({ 
  followUps, 
  currentUserId,
  className 
}: FollowUpHistoryProps) {
  if (followUps.length === 0) {
    return (
      <Card className={cn('border-dashed', className)}>
        <CardContent className="flex flex-col items-center justify-center py-12 text-center">
          <MessageSquare className="w-12 h-12 text-muted-foreground/30 mb-4" />
          <p className="text-sm text-muted-foreground">
            No follow-up history yet
          </p>
          <p className="text-xs text-muted-foreground/70 mt-1">
            Start by adding your first follow-up interaction
          </p>
        </CardContent>
      </Card>
    );
  }

  return (
    <div className={cn('space-y-4', className)}>
      {followUps.map((log, index) => {
        const MethodIcon = contactMethodIcons[log.contact_method];
        const OutcomeIcon = outcomeIcons[log.outcome];
        const NextActionIcon = log.next_action ? nextActionIcons[log.next_action] : null;

        const contactDateTime = new Date(log.contact_date);
        const createdDateTime = new Date(log.created_at);
        const isEdited = log.edited_at !== null;
        const editedDateTime = log.edited_at ? new Date(log.edited_at) : null;

        const creatorInitials = log.user_name
          ? log.user_name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase()
          : 'U';
        
        const editorInitials = log.editor_name
          ? log.editor_name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase()
          : 'U';

        return (
          <Card 
            key={log.id}
            className={cn(
              'relative',
              index === 0 && 'ring-2 ring-primary/20'
            )}
          >
            <CardContent className="p-5">
              {/* HEADER */}
              <div className="flex items-start gap-4 mb-4">
                <Avatar className="w-10 h-10 shrink-0">
                  <AvatarFallback className="bg-primary/10 text-primary font-semibold">
                    {creatorInitials}
                  </AvatarFallback>
                </Avatar>

                <div className="flex-1 min-w-0">
                  <div className="flex flex-wrap items-center gap-2 mb-2">
                    <Badge 
                      variant="outline"
                      className={cn(
                        'flex items-center gap-1.5 font-medium',
                        contactMethodColors[log.contact_method]
                      )}
                    >
                      <MethodIcon className="w-3.5 h-3.5" />
                      {contactMethodLabels[log.contact_method]}
                    </Badge>
                    
                    <span className="text-muted-foreground">→</span>
                    
                    <Badge 
                      variant="outline"
                      className={cn(
                        'flex items-center gap-1.5 font-medium',
                        outcomeColors[log.outcome]
                      )}
                    >
                      <OutcomeIcon className="w-3.5 h-3.5" />
                      {outcomeLabels[log.outcome]}
                    </Badge>

                    {index === 0 && (
                      <Badge variant="default" className="text-xs">
                        Latest
                      </Badge>
                    )}
                  </div>

                  {/* TIMESTAMP */}
                  <div className="flex flex-col gap-1 text-xs text-muted-foreground">
                    <div className="flex items-center gap-2">
                      <Calendar className="w-3 h-3" />
                      <span className="font-medium">Contact:</span>
                      <time dateTime={log.contact_date} className="text-foreground">
                        {format(contactDateTime, 'EEEE, dd MMM yyyy • HH:mm', { locale: idLocale })} WIB
                      </time>
                    </div>

                    <div className="flex items-center gap-2 flex-wrap">
                      <Clock className="w-3 h-3" />
                      <span>Logged:</span>
                      <time dateTime={log.created_at} title={format(createdDateTime, 'dd MMM yyyy HH:mm')}>
                        {formatDistanceToNow(createdDateTime, { 
                          addSuffix: true, 
                          locale: idLocale 
                        })}
                      </time>
                      <span>by</span>
                      <span className="font-medium text-foreground">
                        {log.user_name || 'Unknown'}
                      </span>
                      {log.user_role && (
                        <Badge variant="outline" className="text-xs capitalize">
                          {log.user_role}
                        </Badge>
                      )}
                      {log.user_id === currentUserId && (
                        <Badge variant="secondary" className="text-xs">
                          You
                        </Badge>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              {/* NOTES */}
              {log.notes && (
                <div className="bg-muted/50 rounded-lg p-4 mb-4">
                  <div className="flex items-start gap-2">
                    <FileText className="w-4 h-4 text-muted-foreground shrink-0 mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <p className="text-sm font-medium text-foreground mb-1">
                        Notes:
                      </p>
                      <p className="text-sm text-muted-foreground whitespace-pre-wrap">
                        {log.notes}
                      </p>
                    </div>
                  </div>
                </div>
              )}

              {/* NEXT ACTION */}
              {(log.next_action || log.next_follow_up_date) && (
                <div className="flex items-start gap-3 p-3 rounded-lg bg-blue-50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-800">
                  <ArrowRight className="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
                  <div className="flex-1 min-w-0">
                    <p className="text-xs font-semibold text-blue-900 dark:text-blue-100 uppercase tracking-wide mb-1">
                      Next Action
                    </p>
                    <div className="flex flex-wrap items-center gap-2 text-sm">
                      {log.next_action && NextActionIcon && (
                        <Badge variant="outline" className="bg-white dark:bg-gray-900 flex items-center gap-1.5">
                          <NextActionIcon className="w-3 h-3" />
                          {nextActionLabels[log.next_action]}
                        </Badge>
                      )}
                      {log.next_follow_up_date && (
                        <>
                          <span className="text-muted-foreground">on</span>
                          <Badge variant="secondary" className="flex items-center gap-1.5">
                            <Calendar className="w-3 h-3" />
                            {format(new Date(log.next_follow_up_date), 'dd MMM yyyy', { locale: idLocale })}
                          </Badge>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              )}

              {/* EDIT HISTORY */}
              {isEdited && editedDateTime && (
                <div className="mt-4 pt-3 border-t border-dashed flex items-center gap-2 text-xs text-muted-foreground flex-wrap">
                  <Edit3 className="w-3 h-3" />
                  <span>Last edited</span>
                  <time dateTime={log.edited_at!} title={format(editedDateTime, 'dd MMM yyyy HH:mm')}>
                    {formatDistanceToNow(editedDateTime, { 
                      addSuffix: true, 
                      locale: idLocale 
                    })}
                  </time>
                  {log.editor_name && (
                    <>
                      <span>by</span>
                      <span className="font-medium text-foreground">
                        {log.editor_name}
                      </span>
                      {log.editor_role && (
                        <Badge variant="outline" className="text-xs capitalize">
                          {log.editor_role}
                        </Badge>
                      )}
                      {log.edited_by === currentUserId && (
                        <Badge variant="secondary" className="text-xs">
                          You
                        </Badge>
                      )}
                    </>
                  )}
                </div>
              )}
            </CardContent>
          </Card>
        );
      })}
    </div>
  );
}
